# ---- Backend (copy to backend/.env) ----
ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=campuscart
# Required in production: long random value (openssl rand -hex 32)
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads

# Optional: Gemma listing assistant via any OpenAI-compatible server (e.g. Ollama)
GEMMA_BASE_URL=
GEMMA_MODEL=gemma3:4b
GEMMA_API_KEY=
# Optional: ElevenLabs speech-to-text for voice dictation
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1

# ---- Frontend (frontend/.env) ----
VITE_API_URL=http://localhost:8000

# ---- UNO Q assistant (edge/uno_q/.env) ----
CAMPUSCART_API_URL=http://localhost:8000
CAMPUSCART_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
