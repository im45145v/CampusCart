# ---- Backend (copy to backend/.env) ----
ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=campuscart
# Required in production: long random value (openssl rand -hex 32)
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads

# Hosted Gemma 4 (Gemini API). Leave BASE_URL empty. Key from Google AI Studio.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Optional local override (Ollama / vLLM). Then set GEMMA_MODEL to that server's tag.
# GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_BASE_URL=
# Optional fallback for dictation if the hosted model refuses audio
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1

# Secondary text model. Used when Gemma is unset or a Gemma call fails. Not used for audio.
BACKBOARD_API_KEY=
BACKBOARD_LLM_PROVIDER=openai
BACKBOARD_MODEL=gpt-4o

# Email sign-in (Resend). Leave the key empty in development and the API returns the code.
# Production requires all three. PUBLIC_WEB_URL is the site origin with no trailing slash.
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_WEB_URL=http://localhost:5173

# YouPI-PG wallet top-ups. Leave any of the three empty and checkout stays unavailable.
# YOUPI_API_URL is the payment API origin (port 6100), with no trailing slash.
# Point that merchant's webhook at https://<this-api>/api/payments/youpi
YOUPI_API_URL=
YOUPI_MERCHANT_ID=
YOUPI_WEBHOOK_SECRET=

# Unused for new top-ups. Kept so an older environment still boots.
ADMIN_UPI_ID=im45145v-2@okhdfcbank

# ---- Frontend (frontend/.env) ----
VITE_API_URL=http://localhost:8000

# ---- UNO Q assistant (edge/uno_q/.env) ----
CAMPUSCART_API_URL=http://localhost:8000
CAMPUSCART_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
